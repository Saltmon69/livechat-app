{
  "name": "livechat-overlay",
  "version": "3.0.2",
  "description": "LiveChat Overlay",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.1.8",
    "socket.io-client": "4.7.5"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.livechat.overlay",
    "productName": "LiveChatOverlay",
    "publish": {
      "provider": "github",
      "owner": "Saltmon69",
      "repo": "livechat-app"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "LiveChatOverlay-Setup-${version}.exe"
    },
    "nsis": { "oneClick": true, "perMachine": false },
    "files": ["src/**/*", "assets/**/*", "package.json"]
  }
}
